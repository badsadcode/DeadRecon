; Engine configuration file.
; Godot 4.7.2 .NET, Forward+.

config_version=5

[application]

config/name="Dead Recon"
config/version="0.0.1"
config/description="Co-op jungle tactics sandbox. Bad Ideas Works."
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="DeadRecon"
run/flush_stdout_on_print=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DeadRecon"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
